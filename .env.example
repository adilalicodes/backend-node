# Render sets PORT automatically; this is only for local runs.
PORT=3000

# Allowed frontend origin(s), comma-separated, no trailing slash, no wildcard.
# Required in production (credentialed CORS is limited to these).
FRONTEND_ORIGIN=http://localhost:5173

# Long random string (32+ chars). REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Private JSON user store. Default: backend/data/users.json (git-ignored).
# On Render, point this at a persistent disk mount, e.g. /var/data/users.json
USERS_FILE=./data/users.json

# File-backed session store directory. Defaults to a "sessions" folder next to USERS_FILE.
# SESSIONS_DIR=./data/sessions

# Cookie SameSite: "none" (default in production, needed when the static site and API
# are on different sites such as two *.onrender.com hosts) or "lax" (same-site custom domains).
# COOKIE_SAMESITE=lax

# Dummy demo user (demo@example.com) seeded into the JSON file on startup.
# Defaults to "demo-password-123" outside production; in production it is only
# created if you set this.
# SEED_DEMO_PASSWORD=
